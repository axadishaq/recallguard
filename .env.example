# Copy to .env and fill in. Never commit .env.

# true = offline demo: cached openFDA sample + local SQL engine (no Zetaris needed)
SAMPLE_MODE=true

# --- Zetaris (data layer) — used when SAMPLE_MODE=false ---
ZETARIS_BASE_URL=http://localhost:8888
ZETARIS_ORG_ID=1
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me
ZETARIS_DATABASE=recallguard

# --- Meterless Nightshift runtime (AI provider, OpenAI-compatible) ---
# Token is in <nightshift stateDir>/proxy-token. Leave empty to run without a model.
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_API_KEY=
# Routing modes from GET /v1/models, e.g. meterless/auto, meterless/fast,
# or an NVIDIA Nemotron route configured in Nightshift's Providers tab.
LLM_MODEL=meterless/auto
LLM_MODEL_FAST=meterless/fast
